[physics]

; GoldSrc 手感对 tick 敏感：固定 100 tick（见 docs/MOVEMENT_SPEC.md「固定 tick rate」节）
common/physics_ticks_per_second=100

[rendering]

; 原型期灰盒，无需高级渲染特性
renderer/rendering_method="forward_plus"
