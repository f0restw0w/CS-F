# Godot 4 .gitignore

# Godot 自动生成的导入缓存
.godot/
.import/
export.cfg
export_presets.cfg

# 导出产物
*.exe
*.pck
*.zip
build/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
*.swp
.vscode/
.idea/

# 版权红线：绝不入库任何 Valve 原始资产。
# 我们只把「净室提取的几何坐标」（assets/dust2/*.mesh, *.res）入库，
# 源 .bsp / demo 本身永不进仓库。
*.bsp
*.dem
*.wad
*.spr
